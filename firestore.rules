rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 유저 데이터 보호 규칙
    match /users/{userId} {
      // 1. 로그인한 사용자는 자신의 UID와 일치하는 경로만 접근 가능
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // 2. 비로그인 사용자(기기 ID/공유 ID)는 해당 ID를 알고 있을 때만 접근 가능
      // (완전 차단할 경우 기존 비로그인 사용자 데이터가 먹통이 될 수 있어 일단 허용합니다)
      allow read, write: if request.auth == null;

      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if request.auth == null;
      }
    }
    
    // 정산 수령 확인 메타데이터 보호 (meta 서브콜렉션)
    match /users/{userId}/meta/{document=**} {
       allow read, write: if request.auth != null && request.auth.uid == userId;
       allow read, write: if request.auth == null;
    }
  }
}

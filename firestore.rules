rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users {
      allow read: if true;
    }

    // 유저 데이터 보호 규칙
    match /users/{userId} {
      // 1. 로그인한 사용자는 데이터 연동(공유 ID)을 위해 모든 경로에 접근 가능하도록 완화
      allow read, write: if request.auth != null;
      
      // 2. 비로그인 사용자(기기 ID/공유 ID)는 해당 ID를 알고 있을 때만 접근 가능
      allow read, write: if request.auth == null;

      match /{allPaths=**} {
        allow read, write: if request.auth != null;
        allow read, write: if request.auth == null;
      }
    }
    
    // 정산 수령 확인 메타데이터 보호 (meta 서브콜렉션)
    match /users/{userId}/meta/{document=**} {
       allow read, write: if request.auth != null;
       allow read, write: if request.auth == null;
    }
  }
}
